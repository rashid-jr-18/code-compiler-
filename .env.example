# ==============================================================================
# EduTech Compiler - Server Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL of your deployed application (MUST be HTTPS for Brightspace LTI 1.3)
APP_BASE_URL=https://compiler.yourdomain.com

# ==============================================================================
# Brightspace / D2L LTI 1.3 Advantage Credentials
# (Obtained from Brightspace Admin -> Manage Extensibility -> LTI Advantage)
# ==============================================================================
LTI_CLIENT_ID=your-brightspace-client-id
LTI_DEPLOYMENT_ID=your-brightspace-deployment-id
LTI_TOKEN_URL=https://your-institution.brightspace.com/d2l/oauth2/token
LTI_KEYSET_URL=https://your-institution.brightspace.com/d2l/.well-known/jwks
LTI_LOGIN_URL=https://your-institution.brightspace.com/d2l/lti/login

# RSA Private Key for signing LTI assertions (PEM format, multi-line string or escaped \n)
LTI_TOOL_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ==============================================================================
# External Database Configuration (PostgreSQL / Prisma)
# ==============================================================================
# Connect to your external database server:
# Format: postgresql://<USER>:<PASSWORD>@<EXTERNAL_SERVER_IP_OR_DOMAIN>:<PORT>/<DATABASE_NAME>?sslmode=prefer
DATABASE_URL="postgresql://postgres:your_password@192.168.1.100:5432/edutech_db?schema=public"

# ==============================================================================
# Piston Code Execution Engine
# ==============================================================================
# In local dev: http://localhost:2000/api/v2
# In Docker compose: http://piston:2000/api/v2
PISTON_API_URL=http://piston:2000/api/v2
# Optional custom compile/run timeouts (in ms)
# PISTON_RUN_TIMEOUT=10000

